{
  "name": "madhushala-pro-new-code",
  "version": "1.0.0",
  "private": true,
  "description": "Madhushala Pro rebuilt on Node.js + SQLite with a TUI frontend",
  "type": "module",
  "workspaces": ["backend", "tui"],
  "scripts": {
    "start": "node scripts/start.js",
    "backend": "npm --prefix backend start",
    "tui": "npm --prefix tui start",
    "reset-db": "npm --prefix backend run reset-db",
    "gen-schema": "npm --prefix backend run gen-schema",
    "test": "npm --prefix backend test"
  },
  "engines": { "node": ">=22.5.0" }
}
