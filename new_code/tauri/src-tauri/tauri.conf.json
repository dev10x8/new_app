{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VanijLiquor",
  "version": "1.0.6",
  "identifier": "com.vanijliquor.pro",
  "build": {
    "frontendDist": "../../web/dist",
    "beforeDevCommand": "npm --prefix ../web run start",
    "beforeBuildCommand": "node scripts/stage_runtime.mjs && npm --prefix ../web run build",
    "devUrl": "http://localhost:8080"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "VanijLiquor — Bar & Liquor POS",
        "width": 1360,
        "height": 860,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "resources": {
      "runtime/": "runtime/"
    },
    "category": "Business",
    "shortDescription": "Bar & Liquor POS",
    "longDescription": "VanijLiquor — point of sale for bars and liquor retail, built on Tauri (Web + Rust). Bundles its own Node.js runtime and SQLite backend."
  }
}
