{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Madhushala Pro",
  "version": "1.0.0",
  "identifier": "com.madhushala.pro",
  "build": {
    "frontendDist": "../../web/dist",
    "beforeDevCommand": "npm --prefix ../web run start",
    "beforeBuildCommand": "npm --prefix ../web run build",
    "devUrl": "http://localhost:8080"
  },
  "app": {
    "windows": [
      {
        "title": "Madhushala Pro — Bar & Liquor POS",
        "width": 1360,
        "height": 860,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png"
    ],
    "category": "Business",
    "shortDescription": "Bar & Liquor POS",
    "longDescription": "Madhushala Pro — point of sale for bars and liquor retail, built on Tauri (Web + Rust)."
  }
}
